# ============================================================
# RUHUNU PRODUCTS Billing Suite - Apache / cPanel URL Rewriting
# ============================================================

RewriteEngine On

# Allow direct access to existing files
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route all /api/* requests to api.php?route=*
RewriteRule ^api/(.*)$ api.php?route=$1 [QSA,L]
RewriteRule ^api$ api.php?route=data [QSA,L]

# Security: Protect sensitive files
<FilesMatch "^(db_config\.php|database\.sqlite|schema_sqlite\.sql|\.env|\.git)">
    Order allow,deny
    Deny from all
</FilesMatch>
